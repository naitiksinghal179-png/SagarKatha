# Copy to `.env` (never commit the real file). Everything is optional: the app runs with none of these set.

# --- Speech-to-text (a "Transcribe" button appears when a key is set) ---
SARVAM_API_KEY=
# SARVAM_STT_MODEL=            # leave empty to use Sarvam's default model
OPENAI_API_KEY=
# OPENAI_STT_MODEL=whisper-1

# --- Optional AI topic suggestion (otherwise a keyword classifier is used) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Moderation: set a passcode to hold new stories until approved ---
ADMIN_PASSCODE=

# --- Behaviour ---
SAGARKATHA_OFFLINE=0           # 1 = never call Open-Meteo / GBIF (demos, no internet)
# SAGARKATHA_DATA_DIR=./data   # where user_stories.json and uploads are stored
# SAGARKATHA_MAX_AUDIO_MB=25
